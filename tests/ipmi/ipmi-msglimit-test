#!/bin/bash
#
# ipmi-msglimit-test
#
# IPMI message-path stress test exercising the per-user message limit
# (max_msgs_per_user / nr_msgs).
#
# Sends many IPMI messages through /dev/ipmi0 in a batch-send/drain
# pattern with a lowered max_msgs_per_user limit. This stresses the
# nr_msgs accounting path — the same path reworked by upstream commit
# b52da4054ee0 ("ipmi: Rework user message limit handling").
#
# NOTE: The specific bug fixed by b52da4054ee0 involves kernel-internal
# message paths (IPMB command handling, event delivery, use-after-free
# in deliver_response) that cannot be triggered from userspace via
# /dev/ipmiN ioctls.  The userspace ioctl path is balanced in both the
# old and new code.  This test therefore serves as a regression test —
# proving the rework does not break the normal message path — rather
# than a bug detector.
#
# Author: Claude (Anthropic)
# Prompted-by: Tony Camuso <tcamuso@redhat.com>
#

declare -r SCRIPT_NAME="$(basename "$0")"
declare -r BLD='\e[1m'
declare -r GRN='\e[32m'
declare -r YLW='\e[33m'
declare -r RED='\e[31m'
declare -r OFF='\e[0m'

declare -i opt_verbose=0
declare -i opt_limit=20
declare -i opt_rounds=5
declare opt_logfile=""
declare opt_dev="/dev/ipmi0"

declare -r PARAM="/sys/module/ipmi_msghandler/parameters/max_msgs_per_user"
declare -i saved_limit=0
declare tmpdir=""
declare test_bin=""

usage() {
    cat << USAGE

$SCRIPT_NAME [OPTIONS]

IPMI message-path stress test for the per-user message limit.

Sends messages through /dev/ipmi0 in a batch-send/drain pattern with a
lowered max_msgs_per_user limit, stressing the nr_msgs accounting code
reworked by b52da4054ee0.  Serves as a regression test to verify the
rework does not break the normal ioctl message path.

Options:
    -v          Verbose output
    -l LIMIT    Temporary max_msgs_per_user value (default: $opt_limit)
    -r ROUNDS   Number of batch+drain rounds (default: $opt_rounds)
    -d DEVICE   IPMI device (default: $opt_dev)
    -o FILE     Write results to log file
    -h          Show this help

USAGE
    exit 0
}

log() {
    echo -e "$1"
    [[ -n "$opt_logfile" ]] && echo -e "$1" | sed 's/\x1b\[[0-9;]*m//g' >> "$opt_logfile"
}

cleanup() {
    if [[ $saved_limit -gt 0 && -w "$PARAM" ]]; then
        echo "$saved_limit" > "$PARAM"
        ((opt_verbose)) && log "Restored max_msgs_per_user=$saved_limit"
    fi
    [[ -n "$tmpdir" && -d "$tmpdir" ]] && rm -rf "$tmpdir"
}
trap cleanup EXIT

build_test() {
    tmpdir=$(mktemp -d) || { log "${RED}Cannot create tmpdir${OFF}"; return 1; }
    test_bin="$tmpdir/ipmi-msglimit"

    cat > "$tmpdir/ipmi-msglimit.c" << 'CSOURCE'
/*
 * ipmi-msglimit.c — IPMI message-path stress test.
 *
 * Exercises nr_msgs accounting by sending batches of IPMI messages
 * through a single /dev/ipmiN session with a lowered per-user limit.
 *
 * Strategy — "batch then drain" across multiple rounds:
 *
 *   Each round fires BATCH messages as fast as possible (no recv
 *   between sends), then drains all responses.  This keeps nr_msgs
 *   near the limit during the send phase, stressing the accounting
 *   under load.
 *
 * This is a regression test for the nr_msgs rework in b52da4054ee0.
 * The specific bug fixed by that commit affects kernel-internal paths
 * (IPMB, OEM, event delivery) not reachable from /dev/ipmiN, so this
 * test validates the ioctl path remains correct after the rework.
 *
 * Exit 0: all rounds succeeded.
 * Exit 1: EBUSY detected — unexpected nr_msgs accounting failure.
 * Exit 2: setup / unexpected error.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/ioctl.h>
#include <sys/select.h>
#include <linux/ipmi.h>

static int send_get_devid(int fd, long msgid)
{
    struct ipmi_system_interface_addr addr;
    struct ipmi_req req;

    memset(&addr, 0, sizeof(addr));
    addr.addr_type = IPMI_SYSTEM_INTERFACE_ADDR_TYPE;
    addr.channel = IPMI_BMC_CHANNEL;
    addr.lun = 0;

    memset(&req, 0, sizeof(req));
    req.addr = (unsigned char *)&addr;
    req.addr_len = sizeof(addr);
    req.msgid = msgid;
    req.msg.netfn = 0x06;  /* App */
    req.msg.cmd = 0x01;    /* Get Device ID */
    req.msg.data_len = 0;
    req.msg.data = NULL;

    if (ioctl(fd, IPMICTL_SEND_COMMAND, &req) < 0)
        return -errno;
    return 0;
}

static int recv_msg(int fd, long *msgid_out, int timeout_ms)
{
    struct ipmi_recv msg;
    struct ipmi_addr addr;
    unsigned char data[256];
    fd_set rfds;
    struct timeval tv;

    FD_ZERO(&rfds);
    FD_SET(fd, &rfds);
    tv.tv_sec = timeout_ms / 1000;
    tv.tv_usec = (timeout_ms % 1000) * 1000;

    if (select(fd + 1, &rfds, NULL, NULL, &tv) <= 0)
        return -ETIMEDOUT;

    memset(&msg, 0, sizeof(msg));
    msg.addr = (unsigned char *)&addr;
    msg.addr_len = sizeof(addr);
    msg.msg.data = data;
    msg.msg.data_len = sizeof(data);

    if (ioctl(fd, IPMICTL_RECEIVE_MSG_TRUNC, &msg) < 0)
        return -errno;

    if (msgid_out)
        *msgid_out = msg.msgid;
    return 0;
}

static int drain_responses(int fd, int expected, int verbose)
{
    int received = 0;
    int rc;
    long id;

    while (received < expected) {
        rc = recv_msg(fd, &id, 5000);
        if (rc == -ETIMEDOUT) {
            if (verbose)
                fprintf(stderr, "  drain: timeout after %d/%d received\n",
                        received, expected);
            break;
        }
        if (rc < 0) {
            if (verbose)
                fprintf(stderr, "  drain: recv error: %s\n", strerror(-rc));
            break;
        }
        received++;
    }
    return received;
}

int main(int argc, char *argv[])
{
    const char *dev = "/dev/ipmi0";
    int batch = 20;
    int rounds = 5;
    int verbose = 0;
    int opt, fd, rc;

    while ((opt = getopt(argc, argv, "d:b:r:v")) != -1) {
        switch (opt) {
        case 'd': dev = optarg; break;
        case 'b': batch = atoi(optarg); break;
        case 'r': rounds = atoi(optarg); break;
        case 'v': verbose = 1; break;
        default:
            fprintf(stderr,
                    "Usage: %s [-d dev] [-b batch] [-r rounds] [-v]\n",
                    argv[0]);
            return 2;
        }
    }

    fd = open(dev, O_RDWR);
    if (fd < 0) {
        fprintf(stderr, "Cannot open %s: %s\n", dev, strerror(errno));
        return 2;
    }

    int total_sent = 0, total_recv = 0, total_ebusy = 0;
    long msgid = 0;

    for (int r = 1; r <= rounds; r++) {
        int sent = 0, ebusy = 0;

        if (verbose)
            fprintf(stderr, "Round %d/%d: sending %d messages...\n",
                    r, rounds, batch);

        for (int i = 0; i < batch; i++) {
            msgid++;
            rc = send_get_devid(fd, msgid);
            if (rc == -EBUSY) {
                ebusy++;
                total_ebusy++;
                if (verbose)
                    fprintf(stderr,
                            "  round %d msg %d: EBUSY\n", r, i + 1);
            } else if (rc < 0) {
                fprintf(stderr, "  round %d msg %d: send error: %s\n",
                        r, i + 1, strerror(-rc));
                close(fd);
                return 2;
            } else {
                sent++;
            }
        }

        total_sent += sent;

        int drained = drain_responses(fd, sent, verbose);
        total_recv += drained;

        if (verbose)
            fprintf(stderr, "  sent=%d drained=%d ebusy=%d\n",
                    sent, drained, ebusy);

        if (ebusy > 0) {
            fprintf(stderr,
                    "FAIL at round %d: %d/%d sends hit EBUSY\n",
                    r, ebusy, batch);
            printf("rounds=%d total_sent=%d total_recv=%d "
                   "total_ebusy=%d\n",
                   r, total_sent, total_recv, total_ebusy);
            close(fd);
            return 1;
        }
    }

    close(fd);

    printf("rounds=%d total_sent=%d total_recv=%d total_ebusy=%d\n",
           rounds, total_sent, total_recv, total_ebusy);

    return 0;
}
CSOURCE

    if ! gcc -Wall -o "$test_bin" "$tmpdir/ipmi-msglimit.c" 2>&1; then
        log "${RED}Compilation failed${OFF}"
        return 1
    fi
    ((opt_verbose)) && log "Built $test_bin"
    return 0
}

main() {
    while getopts "vl:r:d:o:h" opt; do
        case "$opt" in
            v) opt_verbose=1 ;;
            l) opt_limit="$OPTARG" ;;
            r) opt_rounds="$OPTARG" ;;
            d) opt_dev="$OPTARG" ;;
            o) opt_logfile="$OPTARG" ;;
            h) usage ;;
            *) usage ;;
        esac
    done

    [[ -n "$opt_logfile" ]] && : > "$opt_logfile"

    log ""
    log "${BLD}════════════════════════════════════════════════════════════${OFF}"
    log "${BLD}  IPMI Message Limit Stress Test${OFF}"
    log "${BLD}════════════════════════════════════════════════════════════${OFF}"
    log ""
    log "Regression test for the nr_msgs accounting rework (b52da4054ee0)."
    log "Stresses the ioctl message path with a lowered per-user limit."
    log ""

    # Preflight checks
    if [[ ! -e "$opt_dev" ]]; then
        log "${RED}FAIL: $opt_dev not found — IPMI driver not loaded?${OFF}"
        exit 2
    fi

    if [[ ! -r "$PARAM" ]]; then
        log "${RED}FAIL: Cannot read $PARAM — ipmi_msghandler not loaded?${OFF}"
        exit 2
    fi

    if ! command -v gcc &>/dev/null; then
        log "${RED}FAIL: gcc not found — needed to compile test program${OFF}"
        exit 2
    fi

    log "Device:             $opt_dev"
    log "Batch size (limit): $opt_limit"
    log "Rounds:             $opt_rounds"
    log "Total messages:     $(( opt_limit * opt_rounds ))"

    # Build the C test program
    log ""
    log "${YLW}Compiling test program...${OFF}"
    if ! build_test; then
        exit 2
    fi

    # Save and lower max_msgs_per_user
    saved_limit=$(cat "$PARAM")
    log "Original max_msgs_per_user=$saved_limit"

    if [[ -w "$PARAM" ]]; then
        echo "$opt_limit" > "$PARAM"
        log "Lowered max_msgs_per_user=$opt_limit"
    else
        log "${YLW}WARNING: Cannot write $PARAM (not root?) — using current limit${OFF}"
        saved_limit=0
    fi

    # --- Test: Batch-send / drain across multiple rounds ---
    log ""
    log "${BLD}Test: Batch-send / drain (message-path stress)${OFF}"
    log "Each round sends $opt_limit messages as fast as possible, then"
    log "drains all responses. Verifies nr_msgs accounting remains"
    log "balanced under load with a tight per-user limit."
    log ""

    local output rc
    if ((opt_verbose)); then
        output=$("$test_bin" -d "$opt_dev" -b "$opt_limit" -r "$opt_rounds" -v 2>&1)
    else
        output=$("$test_bin" -d "$opt_dev" -b "$opt_limit" -r "$opt_rounds" 2>&1)
    fi
    rc=$?

    log "Result: $output"

    if [[ $rc -eq 0 ]]; then
        log ""
        log "${GRN}✓ PASS: All $opt_rounds rounds completed — message path OK${OFF}"
    elif [[ $rc -eq 1 ]]; then
        log ""
        log "${RED}✗ FAIL: Messages hit EBUSY — nr_msgs accounting error${OFF}"
    else
        log ""
        log "${RED}✗ ERROR: Test program failed (exit $rc)${OFF}"
    fi

    log ""
    log "${BLD}════════════════════════════════════════════════════════════${OFF}"
    if [[ $rc -eq 0 ]]; then
        log "${GRN}  MESSAGE LIMIT STRESS TEST PASSED${OFF}"
    else
        log "${RED}  MESSAGE LIMIT STRESS TEST FAILED${OFF}"
    fi
    log "${BLD}════════════════════════════════════════════════════════════${OFF}"

    exit $rc
}

main "$@"
