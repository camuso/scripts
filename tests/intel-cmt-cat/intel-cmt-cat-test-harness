#!/bin/bash
set -euo pipefail

SCRIPTDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOGDIR="rdt_logs"
mkdir -p "$LOGDIR"

COS_MASKS=("0x0f" "0xf0" "0x33" "0xcc")

SUMMARY_FILE="summary.csv"
CSV_FILE=""
RUN_SUMMARY=false
RUN_SECURITY=false
WORKLOAD=""
CORES="0"
IFACE=""

# Use the OS/resctrl interface when resctrl is mounted, MSR otherwise.
if mountpoint -q /sys/fs/resctrl 2>/dev/null; then
    IFACE="-I"
fi

RUN_ALL=false

print_help() {
    echo "Usage: $0 [--all] [--workload=TYPE] [--csv=FILE] [--summary] [--security] [--msr|--os]"
    echo "  --all: Run all tests (security + all workloads) with summary"
    echo "  --workload: cyclictest | stress-ng | fio | iperf3"
    echo "  --csv: CSV file with workload,cores,mask"
    echo "  --summary: Generate summary after tests"
    echo "  --security: Run security regression tests (RHEL-214298, RHEL-214424)"
    echo "  --msr: Force MSR interface (default when resctrl is not mounted)"
    echo "  --os:  Force OS/resctrl interface (default when resctrl is mounted)"
}

parse_args() {
    for arg in "$@"; do
        case $arg in
            --workload=*)
                WORKLOAD="${arg#*=}"
                shift
                ;;
            --csv=*)
                CSV_FILE="${arg#*=}"
                shift
                ;;
            --summary)
                RUN_SUMMARY=true
                shift
                ;;
            --security)
                RUN_SECURITY=true
                shift
                ;;
            --all)
                RUN_ALL=true
                shift
                ;;
            --msr)
                IFACE="-F msr"
                shift
                ;;
            --os)
                IFACE="-I"
                shift
                ;;
            *)
                print_help
                exit 1
                ;;
        esac
    done
}

run_test() {
    local wl="$1"
    local core="$2"
    local mask="$3"
    local log="$LOGDIR/${wl}_${core}_${mask}_$(date +%s).log"

    echo "Running $wl on core $core with COS mask $mask"

    pqos $IFACE -e "llc:1=${mask}" -a "llc:1=${core}"

    case "$wl" in
        cyclictest)
            taskset -c $core cyclictest -p 99 -l 50000 > "$log"
            ;;
        stress-ng)
            taskset -c $core stress-ng --cpu 1 --timeout 15s > "$log"
            ;;
        fio)
            taskset -c $core fio --name=test --rw=randwrite --size=50M --runtime=15s > "$log"
            ;;
        iperf3)
            iperf3 -c localhost -t 15 > "$log"
            ;;
    esac

    if $RUN_SUMMARY; then
        extract_metrics "$wl" "$log" "$core" "$mask"
    fi
}

extract_metrics() {
    local wl="$1"
    local log="$2"
    local core="$3"
    local mask="$4"
    local result=""

    case "$wl" in
        cyclictest)
            result=$(grep "Min:" "$log" | awk '{print $2}')
            ;;
        fio)
            result=$(grep "IOPS=" "$log" | awk -F'=' '{print $2}' | cut -d',' -f1)
            ;;
        iperf3)
            result=$(grep "sender" "$log" | tail -1 | awk '{print $7 $8}')
            ;;
        stress-ng)
            result=$(grep "successful run" "$log")
            ;;
    esac

    echo "$wl,$core,$mask,$result" >> "$SUMMARY_FILE"
}

main_loop() {
    if [[ -n "$CSV_FILE" ]]; then
        while IFS=',' read -r wl core mask; do
            run_test "$wl" "$core" "$mask"
        done < "$CSV_FILE"
    else
        for mask in "${COS_MASKS[@]}"; do
            run_test "$WORKLOAD" "$CORES" "$mask"
        done
    fi

    pqos $IFACE -R
}

run_security_tests() {
    local rc=0

    echo "========================================"
    echo " Security regression tests"
    echo "========================================"
    echo ""

    for test in test-fd-leak.sh test-symlink-race.sh; do
        local path="$SCRIPTDIR/$test"

        if [[ ! -x "$path" ]]; then
            echo "SKIP: $test not found at $path"
            echo ""
            continue
        fi

        echo "--- $test ---"
        "$path" || rc=$?
        echo ""
    done

    return $rc
}

ALL_WORKLOADS=("cyclictest" "stress-ng" "fio")

# Maps command names to the RPM package that provides them.
declare -A CMD_TO_PKG=(
    [cyclictest]=realtime-tests
    [stress-ng]=stress-ng
    [fio]=fio
    [iperf3]=iperf3
    [pqos]=intel-cmt-cat
    [rdtset]=intel-cmt-cat
)

check_deps() {
    local missing_cmds=()
    local missing_pkgs=()

    for cmd in "$@"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing_cmds+=("$cmd")
            local pkg="${CMD_TO_PKG[$cmd]:-$cmd}"
            local already=false
            for p in "${missing_pkgs[@]+"${missing_pkgs[@]}"}"; do
                [[ "$p" == "$pkg" ]] && already=true
            done
            $already || missing_pkgs+=("$pkg")
        fi
    done

    if [[ ${#missing_cmds[@]} -eq 0 ]]; then
        return 0
    fi

    echo "Missing commands: ${missing_cmds[*]}"
    echo "Packages to try:  ${missing_pkgs[*]}"
    echo ""
    echo "  i) Install — attempt dnf install of the above packages"
    echo "  c) Continue — skip tests that need missing tools"
    echo "  q) Quit — exit so you can install manually"
    echo ""
    read -r -p "Choose [i/c/q]: " ans
    case "$ans" in
        [iI]*)
            if ! dnf install -y "${missing_pkgs[@]}"; then
                echo ""
                echo "Some packages failed to install."
                echo ""
                echo "  c) Continue — skip tests that need missing tools"
                echo "  q) Quit — exit so you can find and install them manually"
                echo ""
                read -r -p "Choose [c/q]: " ans2
                case "$ans2" in
                    [cC]*) return 1 ;;
                    *)     exit 1 ;;
                esac
            fi
            ;;
        [cC]*)
            echo "Continuing — tests requiring missing tools will be skipped."
            return 1
            ;;
        *)
            exit 1
            ;;
    esac
}

run_all_tests() {
    RUN_SUMMARY=true

    echo "========================================"
    echo " Comprehensive intel-cmt-cat test run"
    echo "========================================"
    echo ""

    check_deps pqos rdtset "${ALL_WORKLOADS[@]}" || true
    echo ""

    run_security_tests || true
    echo ""

    for wl in "${ALL_WORKLOADS[@]}"; do
        if ! command -v "${wl}" >/dev/null 2>&1; then
            echo "SKIP: $wl not available"
            continue
        fi
        for mask in "${COS_MASKS[@]}"; do
            run_test "$wl" "$CORES" "$mask"
        done
    done

    pqos $IFACE -R

    echo ""
    echo "========================================"
    echo " Summary: $SUMMARY_FILE"
    echo "========================================"
    column -t -s',' "$SUMMARY_FILE" 2>/dev/null || cat "$SUMMARY_FILE"
}

parse_args "$@"

if $RUN_ALL; then
    run_all_tests
    exit $?
fi

if ! $RUN_SECURITY && [[ -z "$WORKLOAD" && -z "$CSV_FILE" ]]; then
    print_help
    exit 1
fi

if $RUN_SECURITY; then
    run_security_tests
fi

if [[ -n "$WORKLOAD" || -n "$CSV_FILE" ]]; then
    if [[ -n "$WORKLOAD" ]]; then
        check_deps pqos "$WORKLOAD" || true
    fi
    main_loop
fi

