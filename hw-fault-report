#** collect_dimm: populated DIMM inventory from DMI
#*
collect_dimm() {
	note "Reading DMI memory inventory"
	if ! command -v dmidecode >/dev/null 2>&1; then
		echo "dmidecode is not installed" >"$workdir/dimm.txt"
		return
	fi
	run_to "$workdir/dmidecode-memory.txt" 30 dmidecode -t memory
	awk '
		function flush() {
			if (size != "" && size !~ /No Module/ && size !~ /Not Installed/ && loc != "") {
				printf "%-22s %-24s %-12s %-6s %-10s %s\n", loc, bank, size, rank, speed, part
				n++
			}
			loc=bank=size=rank=speed=part=""
		}
		{
			line=$0
			sub(/^[[:space:]]+/, "", line)
			if (line ~ /^Handle /) { flush(); next }
			key=line
			sub(/:.*$/, "", key)
			val=line
			sub(/^[^:]*:[[:space:]]*/, "", val)
			if (key=="Locator") loc=val
			else if (key=="Bank Locator") bank=val
			else if (key=="Size") size=val
			else if (key=="Rank") rank=val
			else if (key=="Part Number") part=val
			else if (key=="Configured Memory Speed") speed=val
		}
		END {
			flush()
			printf "populated_dimms %d\n", n+0
		}
	' "$workdir/dmidecode-memory.txt" >"$workdir/dimm.txt"
}

#** node_sweep_plan: one stress-ng command per NUMA node
#*
node_sweep_plan() {
	local oom="" node mb use
	: >"$workdir/commands.txt"
	if ! command -v numactl >/dev/null 2>&1; then
		echo "numactl is not installed" >"$workdir/commands.txt"
		planned_note="numactl is not installed, so no per-node command was built"
		return
	fi
	if ! command -v stress-ng >/dev/null 2>&1; then
		planned_note="stress-ng is not installed. Commands below are what to run after it is installed."
	fi
	if command -v stress-ng >/dev/null 2>&1 && stress-ng --help 2>&1 | grep -q -- '--oom-avoid'; then
		oom="--oom-avoid "
	fi
	while read -r node mb; do
		[[ "$mb" =~ ^[0-9]+$ ]] || continue
		use=$((mb * opt_node_percent / 100))
		if ((use < 1)); then
			continue
		fi
		printf 'numactl -m %s stress-ng %s--vm 1 --vm-bytes %sM --madvise 2 --userfaultfd 2 --timeout %s --metrics-brief\n' \
			"$node" "$oom" "$use" "$opt_node_seconds"
	done < <(numactl -H | awk '$1=="node" && $3=="size:" {print $2, $4}') >"$workdir/commands.txt"
}

#** collect_numa: node map and the sweep commands
#*
collect_numa() {
	if command -v numactl >/dev/null 2>&1; then
		numactl -H >"$workdir/numa.txt" 2>&1 || true
	else
		echo "numactl is not installed" >"$workdir/numa.txt"
	fi
	node_sweep_plan
	{
		echo
		echo "==== planned node sweep ===="
		cat "$workdir/commands.txt"
	} >>"$workdir/numa.txt"
}

#** run_reproduce: run the node sweep and stop at the first new fault
#*
run_reproduce() {
	local line node before after k_before k_after rc
	local -i poisoned=0
	local -i killed=0
	{
		echo "A node sweep can panic the machine if an uncorrected error is in kernel memory."
		echo
	} >"$workdir/repro.txt"
	if ! command -v numactl >/dev/null 2>&1 || ! command -v stress-ng >/dev/null 2>&1; then
		echo "Sweep not started. numactl and stress-ng are both required." >>"$workdir/repro.txt"
		return
	fi
	if ! grep -q '^numactl ' "$workdir/commands.txt"; then
		echo "Sweep not started. No node commands were built." >>"$workdir/repro.txt"
		return
	fi
	while IFS= read -r line; do
		[[ "$line" == numactl\ * ]] || continue
		node="$(awk '{print $3}' <<<"$line")"
		before="$(awk '/^HardwareCorrupted:/{print $2}' /proc/meminfo)"
		k_before="$(dmesg 2>/dev/null | grep -Ec 'MCE: Killing|hardware memory corruption' || true)"
		note "Node $node sweep for ${opt_node_seconds}s"
		echo "---- node $node ----" >>"$workdir/repro.txt"
		echo "command: $line" >>"$workdir/repro.txt"
		echo "hardware_corrupted_before_kb: ${before:-unknown}" >>"$workdir/repro.txt"
		echo "kill_lines_before: ${k_before:-0}" >>"$workdir/repro.txt"
		rc=0
		timeout "$((opt_node_seconds + 45))" bash -c "$line" >>"$workdir/repro.txt" 2>&1 || rc=$?
		after="$(awk '/^HardwareCorrupted:/{print $2}' /proc/meminfo)"
		k_after="$(dmesg 2>/dev/null | grep -Ec 'MCE: Killing|hardware memory corruption' || true)"
		echo "exit: $rc" >>"$workdir/repro.txt"
		echo "hardware_corrupted_after_kb: ${after:-unknown}" >>"$workdir/repro.txt"
		echo "kill_lines_after: ${k_after:-0}" >>"$workdir/repro.txt"
		poisoned=0
		killed=0
		if [[ "$before" =~ ^[0-9]+$ && "$after" =~ ^[0-9]+$ ]] && ((after > before)); then
			poisoned=1
		fi
		if [[ "$k_before" =~ ^[0-9]+$ && "$k_after" =~ ^[0-9]+$ ]] && ((k_after > k_before)); then
			killed=1
			echo "new dmesg kill lines:" >>"$workdir/repro.txt"
			dmesg -T 2>/dev/null | grep -E 'MCE: Killing|hardware memory corruption' | tail -n "$((k_after - k_before + 2))" >>"$workdir/repro.txt" || true
		fi
		if ((poisoned || killed)); then
			echo "STOPPED on node $node" >>"$workdir/repro.txt"
			add_finding "FAULT" "The NUMA-node sweep faulted on node $node. HardwareCorrupted went from ${before:-unknown} kB to ${after:-unknown} kB, and kill lines went from ${k_before:-0} to ${k_after:-0}. That node's DIMMs are the set to swap."
			return
		fi
	done <"$workdir/commands.txt"
	echo "Sweep finished with no new HardwareCorrupted count and no new MCE line." >>"$workdir/repro.txt"
	add_finding "OK" "The NUMA-node sweep finished without a new poisoned page or MCE line. That does not repair the earlier fault; it means this pass did not touch a bad cell."
}

#** build_findings: turn the collected files into the lead paragraphs
#*
build_findings() {
	local kills addr payload_empty=0
	kills=$((journal_kills + dmesg_kills))
	addr=$((journal_addr + dmesg_addr))

	if ((kills > 0)); then
		add_finding "FAULT" "The kernel log has ${kills} hardware memory-corruption kill line(s) (journal ${journal_kills}, dmesg ${dmesg_kills}). The address on a 'MCE: Killing' line is a user virtual address of the process that consumed the poison, not a DIMM address."
	else
		add_finding "GAP" "No 'MCE: Killing' line is in the current dmesg buffer or the kernel journal since ${opt_since}. If those lines were seen earlier, they have rotated out."
	fi

	if ((hc_kb > 0)); then
		local poison_extra=""
		if ((poison_truncated > 0)); then
			poison_extra=", plus ${poison_truncated} more not listed"
		fi
		add_finding "FAULT" "HardwareCorrupted is ${hc_kb} kB, so poisoned pages are still offlined in this boot. The page-flag scan found ${poison_pfns} flagged PFN(s)${poison_extra}."
	elif ((hc_kb == 0)); then
		if ((boot_after_incident == 1)); then
			add_finding "INFO" "HardwareCorrupted is 0 kB. This boot started at ${boot_since}, which is after ${opt_incident}, so a zero count does not erase that incident. Poison from before the reboot is gone."
		else
			add_finding "OK" "HardwareCorrupted is 0 kB. This boot is not holding poisoned pages."
		fi
	else
		add_finding "GAP" "HardwareCorrupted is not present in /proc/meminfo, and the page-flag scan found ${poison_pfns} PFN(s)."
	fi

	if ((addr > 0)); then
		add_finding "INFO" "The kernel log contains MCA ADDR or SYND fields. Those are the physical-side values. A DIMM label still requires EDAC or the AMD address translator for this CPU."
	elif ((kills > 0)); then
		add_finding "GAP" "The kill lines are present and no MCA ADDR or SYND was kept with them. The physical address was not retained."
	fi

	if ((edac_preexisting && edac_ue > 0)); then
		add_finding "FAULT" "EDAC was already loaded and reports uncorrected errors on: ${edac_ue_where}"
	elif ((edac_preexisting)); then
		add_finding "INFO" "EDAC is loaded from before this run. Corrected total ${edac_ce}, uncorrected total ${edac_ue}."
	elif ((edac_ue > 0 || edac_ce > 0)); then
		add_finding "INFO" "amd64_edac bound when this script loaded it (${edac_load}). Counters started at load time: corrected ${edac_ce}, uncorrected ${edac_ue}. They do not include the earlier fault."
	elif [[ -n "$edac_load" ]]; then
		add_finding "GAP" "No EDAC DIMM is registered. ${edac_load}. CPU is family ${cpu_family:-unknown} model ${cpu_model:-unknown} stepping ${cpu_stepping:-unknown} (${cpu_name:-unknown}). A module that does not know this family cannot name a slot."
	else
		add_finding "GAP" "No EDAC DIMM is registered, so there is no per-slot corrected or uncorrected count."
	fi

	if ((ras_installed == 0)); then
		add_finding "GAP" "rasdaemon is not installed, so machine checks are not being stored in a database."
	elif ((ras_has_mc_event == 1)); then
		add_finding "OK" "rasdaemon has an mc_event table. Errors recorded after the daemon was started with --record can be listed with ras-mc-ctl --errors."
	elif ((ras_records_flag == 0)); then
		add_finding "GAP" "rasdaemon's ExecStart does not include -r/--record, so it will not create mc_event. Earlier machine checks were not saved there."
	else
		add_finding "GAP" "rasdaemon is configured to record, but mc_event is missing from its database. Earlier machine checks were not saved. Re-run with --repair-rasdaemon to recreate the database."
	fi

	if ((ipmi_present == 0)); then
		add_finding "GAP" "ipmitool is not installed, so the SEL was not read."
	else
		if ((sel_before < 0)); then
			add_finding "GAP" "SEL info did not return an entry count. The BMC or the IPMI driver did not answer Get SEL Info."
		elif ((sel_after > sel_before)); then
			add_finding "INFO" "SEL entries went from ${sel_before} to ${sel_after} while this script read the log. Something is appending records during SEL reads. Do not walk the full log again until that stops."
		elif ((sel_after == sel_before)); then
			add_finding "OK" "SEL holds ${sel_before} entries, overflow is ${sel_overflow:-unknown}, and the count did not change while the sample was read."
		elif ((sel_after < 0)); then
			add_finding "GAP" "SEL info returned ${sel_before} entries before the sample and did not return a count after it."
		else
			add_finding "INFO" "SEL count went from ${sel_before} before the sample to ${sel_after} after it."
		fi
		if ((sel_before > 0 && sel_parsed == 0)); then
			add_finding "GAP" "SEL info reports ${sel_before} entries, but the sample walk did not parse a record. The list output is in the SEL section."
		fi
		if ((sel_parsed > 0 && sel_unique_ids == 1)); then
			add_finding "INFO" "All ${sel_parsed} sampled SEL lines use record id ${sel_last_id}. That is one id stamped onto many rows, not ${sel_parsed} distinct record keys."
		fi
		if ((sel_get_ok == 0)); then
			add_finding "INFO" "ipmitool sel get 0x${sel_last_id} was rejected. The id printed by sel list is not a key this BMC will fetch. Use the walk from record 0, which is what the sample already did."
		elif ((sel_get_ok == 1)); then
			add_finding "OK" "ipmitool sel get 0x${sel_last_id} succeeded. Direct SEL reads work for that id."
		fi
		if ((sel_unique_stamps == 1 && sel_parsed > 1)); then
			add_finding "INFO" "The sampled SEL rows share a single timestamp. They were logged in the same second, or the BMC timestamp is stuck. Compare 'sel time' with the host clock in the details."
		fi
		if echo "$sel_payload" | grep -q '02ffff' && [[ "$(echo "$sel_payload" | grep -c .)" -le 1 ]]; then
			payload_empty=1
		fi
		if [[ -f "$workdir/sel-file.txt" ]]; then
			local dominant=""
			dominant="$(awk -F'\t' '/^payload /{print $2; exit}' "$workdir/sel-file.txt")"
			if [[ "$dominant" == *"0x02 0xff 0xff"* || "$dominant" == *"data=02ffff"* ]]; then
				payload_empty=1
			fi
		fi
		if ((payload_empty)); then
			add_finding "GAP" "SEL event data is the empty System Event payload (offset 0x02, bytes ff ff). Those rows say 'Undetermined system hardware failure' and do not name a FRU. The file is ${sel_file_note:-not present} (${sel_file_records} records, ${sel_file_unique} unique)."
		elif [[ -n "$sel_payload" ]]; then
			add_finding "INFO" "SEL event-data bytes from the verbose sample: ${sel_payload}"
		fi
		if ((sel_clock_delta > 120)); then
			add_finding "INFO" "SEL clock and host clock differ by ${sel_clock_delta} seconds. SEL timestamps are not host time."
		fi
	fi

	if [[ -n "$ipmi_selftest" ]]; then
		if echo "$ipmi_selftest" | grep -qi 'passed'; then
			add_finding "OK" "BMC self-test passed. The IPMI device responds."
		elif echo "$ipmi_selftest" | grep -qi 'TIMED OUT\|Unable to send\|No data available'; then
			add_finding "GAP" "BMC self-test did not complete: ${ipmi_selftest}"
		else
			add_finding "INFO" "BMC self-test: ${ipmi_selftest}"
		fi
	fi
	if [[ -n "$ipmi_guid_sys" ]]; then
		if echo "$ipmi_guid_sys" | grep -qi 'Invalid command\|rsp=0xc1\|rsp=0xC1'; then
			add_finding "OK" "Get System GUID (raw 0x06 0x37) is not implemented (invalid command). Get Device ID in the same run shows the message path works. The functional-test failure is this unsupported command."
		elif echo "$ipmi_guid_sys" | grep -qi 'TIMED OUT\|Unable to send'; then
			add_finding "GAP" "Get System GUID failed in transport: ${ipmi_guid_sys}"
		elif [[ "$(cat "$workdir/raw-sysguid.txt.rc" 2>/dev/null || echo 1)" -eq 0 ]]; then
			add_finding "OK" "Get System GUID succeeded."
		else
			add_finding "INFO" "Get System GUID: ${ipmi_guid_sys}"
		fi
	fi
	if [[ -n "$ipmi_identify" ]]; then
		if echo "$ipmi_identify" | grep -qi 'Invalid command\|rsp=0xc1\|Invalid data\|rsp=0xcc\|rsp=0xCC'; then
			add_finding "OK" "Chassis identify 5 was rejected as an unsupported or invalid request: ${ipmi_identify} The LED command is not evidence of the memory fault."
		elif echo "$ipmi_identify" | grep -qi 'TIMED OUT\|Unable to send'; then
			add_finding "GAP" "Chassis identify did not complete: ${ipmi_identify}"
		elif [[ "$(cat "$workdir/identify-on.txt.rc" 2>/dev/null || echo 1)" -eq 0 ]]; then
			add_finding "OK" "Chassis identify 5 succeeded, and identify 0 was sent afterward."
		else
			add_finding "INFO" "Chassis identify 5: ${ipmi_identify}"
		fi
	fi

	if ((opt_reproduce == 0)); then
		if ((edac_preexisting && edac_ue > 0)); then
			planned_note="EDAC already names the uncorrected DIMM. A node sweep is only needed if you want a second confirmation. Commands are in the NUMA section."
		else
			planned_note="No slot was named. Run the same script with --reproduce to sweep one NUMA node at a time and stop at the first new fault. Commands are in the NUMA section. ${planned_note}"
		fi
	fi
}

#** render: findings first, then the evidence that produced them
#*
render() {
	local line level text n=0 report
	report="$workdir/report.txt"
	{
		echo "hw-fault-report $VERSION"
		echo "command: $SCRIPT_NAME $*"
		echo
		if [[ -f "$workdir/host.txt" ]]; then
			cat "$workdir/host.txt"
		fi
		echo
		echo "CONCLUSION"
		echo "----------------------------------------------------------------------"
		if ((report_exit == 1)); then
			echo "Uncorrected memory-error evidence is on this machine."
		else
			echo "This run did not find uncorrected memory-error evidence still on the machine."
		fi
		if ((edac_preexisting && edac_ue > 0)); then
			echo "EDAC names the DIMM. Replace that module, then confirm the uncorrected count stays at zero."
		elif ((journal_kills + dmesg_kills > 0 || hc_kb > 0)); then
			if ((journal_addr + dmesg_addr > 0)); then
				echo "An MCA ADDR or SYND was logged. It is in the kernel-log section."
				echo "EDAC did not turn that address into a DIMM label."
			else
				echo "The failing slot is not in the retained SEL, EDAC, or MCA address fields."
				echo "Isolate it by NUMA node, then by swapping one DIMM out of the node that faults."
			fi
		else
			echo "If the fault was real and the logs have rotated, enable rasdaemon --record before the next run so the next kill keeps an address."
		fi
		echo
		echo "FINDINGS"
		echo "----------------------------------------------------------------------"
		for line in "${findings[@]}"; do
			n=$((n + 1))
			level="${line%%$'\t'*}"
			text="${line#*$'\t'}"
			printf '%2d. %-5s %s\n' "$n" "$level" "$text"
		done
		echo
		echo "NEXT STEP"
		echo "----------------------------------------------------------------------"
		if ((opt_reproduce)); then
			echo "A node sweep was requested. Its output is in the REPRODUCE section."
		else
			echo "${planned_note:-See the NUMA section for per-node commands.}"
			echo
			echo "    $SCRIPT_NAME --reproduce"
		fi
		echo
		echo "The address on 'MCE: Killing ... fault at <hex>' is a userspace virtual address."
		echo "SEL text 'Undetermined system hardware failure' with event data 02ffff has no slot in it."
		echo
		echo "DETAILS: HOST"
		echo "----------------------------------------------------------------------"
		cat "$workdir/host.txt" 2>/dev/null || true
		echo
		echo "DETAILS: POISONED PAGES"
		echo "----------------------------------------------------------------------"
		cat "$workdir/poison.txt" 2>/dev/null || true
		echo
		echo "DETAILS: KERNEL LOG"
		echo "----------------------------------------------------------------------"
		cat "$workdir/kernel.txt" 2>/dev/null || true
		echo
		echo "DETAILS: CPU"
		echo "----------------------------------------------------------------------"
		cat "$workdir/cpu.txt" 2>/dev/null || true
		echo
		echo "DETAILS: EDAC"
		echo "----------------------------------------------------------------------"
		cat "$workdir/edac.txt" 2>/dev/null || true
		echo
		echo "DETAILS: RASDAEMON"
		echo "----------------------------------------------------------------------"
		cat "$workdir/ras.txt" 2>/dev/null || true
		echo
		echo "DETAILS: SEL"
		echo "----------------------------------------------------------------------"
		cat "$workdir/sel.txt" 2>/dev/null || true
		echo
		echo "DETAILS: IPMI COMMANDS"
		echo "----------------------------------------------------------------------"
		cat "$workdir/ipmi.txt" 2>/dev/null || true
		echo
		echo "DETAILS: DIMMS"
		echo "----------------------------------------------------------------------"
		cat "$workdir/dimm.txt" 2>/dev/null || true
		echo
		echo "DETAILS: NUMA"
		echo "----------------------------------------------------------------------"
		cat "$workdir/numa.txt" 2>/dev/null || true
		if [[ -f "$workdir/repro.txt" ]]; then
			echo
			echo "DETAILS: REPRODUCE"
			echo "----------------------------------------------------------------------"
			cat "$workdir/repro.txt"
		fi
	} >"$report"

	cat "$report"
	if [[ -n "$opt_outfile" ]]; then
		cp "$report" "$opt_outfile"
		note "Wrote $opt_outfile"
	fi
}

#** self_test: check the parsers without root or a live SEL
#*
self_test() {
	local page flags_file sel_text sel_bin summary dominant
	local -i failures=0

	workdir="$(mktemp -d /tmp/hw-fault-report.XXXXXX)"
	page="$(getconf PAGE_SIZE)"
	flags_file="$workdir/kpageflags"
	python3 - "$flags_file" <<'PY'
import struct, sys
flags = [0] * 8
flags[3] = 1 << 19
flags[4] = 1 << 19
flags[7] = 1 << 19
open(sys.argv[1], "wb").write(struct.pack("<8Q", *flags))
PY
	export HW_FAULT_KPAGEFLAGS="$flags_file"
	scan_hwpoison
	unset HW_FAULT_KPAGEFLAGS
	if [[ "$poison_pfns" -ne 3 ]]; then
		echo "FAIL poison count $poison_pfns" >&2
		failures=$((failures + 1))
	fi
	if ! grep -q '^range 0x3 0x4 ' "$workdir/poison.txt"; then
		echo "FAIL missing contiguous range" >&2
		failures=$((failures + 1))
	fi
	if ! grep -q '^range 0x7 0x7 ' "$workdir/poison.txt"; then
		echo "FAIL missing single pfn" >&2
		failures=$((failures + 1))
	fi

	sel_text="$workdir/sel-save.txt"
	{
		echo "0x04 0x12 0x01 0x6f 0x02 0xff 0xff # System Event #0x01 Undetermined system hardware failure"
		echo "0x04 0x12 0x01 0x6f 0x02 0xff 0xff # System Event #0x01 Undetermined system hardware failure"
		echo "0x04 0x0c 0x01 0x6f 0xa0 0x00 0x01 # Memory #0x01 Correctable ECC"
	} >"$sel_text"
	opt_sel_file="$sel_text"
	inspect_sel_file
	if [[ "$sel_file_records" -ne 3 || "$sel_file_unique" -ne 2 ]]; then
		echo "FAIL text sel records=$sel_file_records unique=$sel_file_unique" >&2
		failures=$((failures + 1))
	fi
	dominant="$(awk -F'\t' '/^payload /{print $2; exit}' "$workdir/sel-file.txt")"
	if [[ "$dominant" != *"0x02 0xff 0xff"* ]]; then
		echo "FAIL dominant payload: $dominant" >&2
		failures=$((failures + 1))
	fi

	sel_bin="$workdir/sel.bin"
	python3 - "$sel_bin" <<'PY'
import struct, sys
rec = struct.pack("<HBIHBBBBBBB", 0x7bea, 2, 1700000000, 0x0020, 4, 0x12, 0x01, 0x6f, 0x02, 0xff, 0xff)
open(sys.argv[1], "wb").write(rec * 2)
PY
	opt_sel_file="$sel_bin"
	inspect_sel_file
	if [[ "$sel_file_records" -ne 2 || "$sel_file_unique" -ne 1 ]]; then
		echo "FAIL binary sel records=$sel_file_records unique=$sel_file_unique" >&2
		failures=$((failures + 1))
	fi
	if ! grep -q 'data=02ffff' "$workdir/sel-file.txt"; then
		echo "FAIL binary event data" >&2
		cat "$workdir/sel-file.txt" >&2
		failures=$((failures + 1))
	fi

	cat >"$workdir/sel-list.txt" <<'EOF'
7bea | 11/02/2026 | 18:39:06 | System Event #0x01 | Undetermined system hardware failure | Asserted
7bea | 11/02/2026 | 18:39:06 | System Event #0x01 | Undetermined system hardware failure | Asserted
294e | 10/31/2026 | 01:29:35 AM EDT | System Event #0x01 | Undetermined system hardware failure | Asserted
noise that is not a record
EOF
	summary="$(summarize_sel_list "$workdir/sel-list.txt")"
	if [[ "$summary" != *"parsed 3"* || "$summary" != *"unique_ids 2"* || "$summary" != *"unique_stamps 2"* ]]; then
		echo "FAIL sel list summary:" >&2
		printf '%s\n' "$summary" >&2
		failures=$((failures + 1))
	fi

	if ((failures == 0)); then
		echo "self-test passed"
		return 0
	fi
	echo "self-test failed: $failures" >&2
	return 1
}

#** main: collect, interpret, print
#*
main() {
	trap control_c SIGINT
	trap cleanup EXIT

	parse_args "$@"
	if ((opt_self_test)); then
		self_test
		exit $?
	fi
	require_root

	if [[ -z "$opt_since" ]]; then
		opt_since="$(date -d "$opt_since_default" '+%Y-%m-%d %H:%M:%S')"
	fi

	workdir="$(mktemp -d /tmp/hw-fault-report.XXXXXX)"
	note "Work directory $workdir"

	collect_host
	collect_poison
	collect_kernel
	collect_cpu
	collect_edac
	collect_ras
	collect_sel
	collect_ipmi_cmds
	collect_dimm
	collect_numa
	if ((opt_reproduce)); then
		run_reproduce
	fi
	build_findings
	render "$@"
	exit "$report_exit"
}

main "$@"
