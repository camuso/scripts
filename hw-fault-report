#!/bin/bash
#
# hw-fault-report
#
# Collect SEL, MCA, EDAC, and poisoned-page evidence and print what it
# can and cannot prove about an uncorrected memory fault.
#
# Poisoned frames are found by reading /proc/kpageflags (KPF_HWPOISON,
# bit 19). page-types is not required.
#
# Prompted-by: Tony Camuso <tcamuso@redhat.com>
#

declare -r VERSION="1.0"
declare -r SCRIPT_NAME="$(basename "$0")"
declare -r KPF_HWPOISON_BIT=19

declare -i opt_list_count=40
declare -i opt_verbose_count=3
declare -i opt_reproduce=0
declare -i opt_repair_ras=0
declare -i opt_load_edac=1
declare -i opt_scan_pfns=0
declare -i opt_self_test=0
declare -i opt_node_seconds=120
declare -i opt_node_percent=70
declare opt_since=""
declare opt_since_default="14 days ago"
declare opt_incident="2026-10-31 23:41:00"
declare opt_sel_file=""
declare opt_outfile=""

declare workdir=""
declare -i report_exit=0

declare -a findings=()

declare -i hc_kb=-1
declare -i poison_pfns=0
declare -i poison_truncated=0
declare -i journal_kills=0
declare -i journal_addr=0
declare -i dmesg_kills=0
declare -i dmesg_addr=0
declare -i edac_preexisting=0
declare -i edac_ue=0
declare -i edac_ce=0
declare edac_ue_where=""
declare edac_load=""
declare cpu_family=""
declare cpu_model=""
declare cpu_stepping=""
declare cpu_name=""
declare boot_since=""
declare -i boot_after_incident=-1
declare -i ras_installed=0
declare -i ras_active=0
declare -i ras_records_flag=0
declare -i ras_has_mc_event=-1
declare -i sel_before=-1
declare -i sel_after=-1
declare sel_overflow=""
declare -i sel_parsed=0
declare -i sel_unique_ids=0
declare -i sel_unique_stamps=0
declare sel_last_id=""
declare sel_desc_summary=""
declare sel_payload=""
declare -i sel_get_ok=-1
declare -i sel_file_records=0
declare -i sel_file_unique=0
declare sel_file_note=""
declare -i ipmi_present=0
declare ipmi_selftest=""
declare ipmi_guid_sys=""
declare ipmi_guid_dev=""
declare ipmi_identify=""
declare -i selftest_rc=-1
declare -i sysguid_rc=-1
declare -i devid_rc=-1
declare -i identify_rc=-1
declare -i sel_clock_delta=-1
declare planned_note=""

declare usagestr="$(
cat <<EOF
$SCRIPT_NAME [-h|--help] [OPTIONS]

Read the SEL, the kernel log, EDAC, and poisoned page flags, then print
a findings report. The poisoned-page scan reads /proc/kpageflags directly.

Does not clear the SEL. Does not stress memory unless --reproduce is given.
Loading amd64_edac is attempted when no memory controller is registered.

Exit codes:
  0    Report finished, no uncorrected-memory evidence
  1    Uncorrected-memory evidence found
  2    Usage error, or not run as root
  130  Interrupted

Options:
  -h, --help              Show this help
  -o, --output FILE       Also write the report to FILE
  --since TIME            Kernel journal start (default: $opt_since_default)
  --incident TIME         Fault time used to interpret this boot
                          (default: $opt_incident)
  --sel-file FILE         sel save text file (default: newest /tmp/sel-*.bin)
  --no-load-edac          Do not modprobe amd64_edac
  --scan-pfns             Scan page flags even if HardwareCorrupted is 0
  --repair-rasdaemon      Replace an empty rasdaemon database and restart
                          the service when it is already started with --record
  --reproduce             Sweep each NUMA node with stress-ng until one faults
  --node-seconds N        Per-node stress time in seconds (default: $opt_node_seconds)
  --node-percent N        Percent of that node's memory to allocate (default: $opt_node_percent)
  --list-count N          SEL records to sample from the oldest (default: $opt_list_count)
  --verbose-count N       SEL records to print in full (default: $opt_verbose_count)
  --self-test             Check the page-flag and SEL parsers, then exit

EOF
)"

#** usage: print usage information
#*
usage() {
	echo -e "$usagestr"
}

#** control_c: control-c trap
#*
control_c() {
	echo -e "\nCtrl-c detected. Stopping." >&2
	exitme 130
}

#** exitme: exit with code and optional message
#*
# Arguments
#   $1 - exit code
#   $2 - optional message
#*
exitme() {
	local -i code="$1"
	local msg="${2:-}"

	[[ -n "$msg" ]] && echo -e "$msg" >&2
	if ((code == 2)); then
		usage >&2
	fi
	exit "$code"
}

#** cleanup: remove the temporary work directory
#*
cleanup() {
	if [[ -n "$workdir" && -d "$workdir" ]]; then
		rm -rf "$workdir"
		workdir=""
	fi
}

#** note: progress on stderr so the report on stdout stays clean
#*
# Arguments
#   $* - message
#*
note() {
	echo "==> $*" >&2
}

#** parse_args: set options from the command line
#*
# Arguments
#   $@ - argv
#*
parse_args() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-h|--help|help)
				usage
				exit 0
				;;
			-o|--output)
				[[ $# -ge 2 ]] || exitme 2 "Missing argument for $1"
				opt_outfile="$2"
				shift 2
				;;
			--since)
				[[ $# -ge 2 ]] || exitme 2 "Missing argument for $1"
				opt_since="$2"
				shift 2
				;;
			--incident)
				[[ $# -ge 2 ]] || exitme 2 "Missing argument for $1"
				opt_incident="$2"
				shift 2
				;;
			--sel-file)
				[[ $# -ge 2 ]] || exitme 2 "Missing argument for $1"
				opt_sel_file="$2"
				shift 2
				;;
			--no-load-edac)
				opt_load_edac=0
				shift
				;;
			--scan-pfns)
				opt_scan_pfns=1
				shift
				;;
			--self-test)
				opt_self_test=1
				shift
				;;
			--repair-rasdaemon)
				opt_repair_ras=1
				shift
				;;
			--reproduce)
				opt_reproduce=1
				shift
				;;
			--node-seconds)
				[[ $# -ge 2 ]] || exitme 2 "Missing argument for $1"
				opt_node_seconds="$2"
				shift 2
				;;
			--node-percent)
				[[ $# -ge 2 ]] || exitme 2 "Missing argument for $1"
				opt_node_percent="$2"
				shift 2
				;;
			--list-count)
				[[ $# -ge 2 ]] || exitme 2 "Missing argument for $1"
				opt_list_count="$2"
				shift 2
				;;
			--verbose-count)
				[[ $# -ge 2 ]] || exitme 2 "Missing argument for $1"
				opt_verbose_count="$2"
				shift 2
				;;
			*)
				exitme 2 "Unknown option: $1"
				;;
		esac
	done

	if ((opt_node_seconds < 1)); then
		exitme 2 "--node-seconds must be >= 1"
	fi
	if ((opt_node_percent < 1 || opt_node_percent > 100)); then
		exitme 2 "--node-percent must be 1-100"
	fi
	if ((opt_list_count < 1 || opt_verbose_count < 1)); then
		exitme 2 "SEL sample counts must be >= 1"
	fi
}

#** require_root: this report reads the SEL device and page flags
#*
require_root() {
	if [[ "$(id -u)" -ne 0 ]]; then
		exitme 2 "Must be root to read /proc/kpageflags, the SEL, and DMI."
	fi
}

#** run_to: run a command with a timeout and keep combined output
#*
# Arguments
#   $1 - output file
#   $2 - timeout seconds
#   $3... - command
#*
run_to() {
	local out="$1"
	local -i secs="$2"
	shift 2
	local -i rc=0

	timeout --signal=TERM "$secs" "$@" >"$out" 2>&1 || rc=$?
	printf '%s\n' "$rc" >"${out}.rc"
	if ((rc == 124)); then
		echo "TIMED OUT after ${secs}s" >>"$out"
	fi
	return 0
}

#** add_finding: record one interpreted result
#*
# Arguments
#   $1 - FAULT, GAP, OK, or INFO
#   $2 - sentence
#*
add_finding() {
	findings+=("$1"$'\t'"$2")
	if [[ "$1" == "FAULT" ]]; then
		report_exit=1
	fi
}

#** edac_dimm_count: number of EDAC dimm_label files
#*
edac_dimm_count() {
	find /sys/devices/system/edac/mc -name dimm_label 2>/dev/null | wc -l
}

#** read_edac_counts: sum CE/UE and list labels that have seen a UE
#*
read_edac_counts() {
	local label_file dir label ce ue
	edac_ue=0
	edac_ce=0
	edac_ue_where=""
	: >"$workdir/edac-dimms.txt"

	while IFS= read -r label_file; do
		dir="$(dirname "$label_file")"
		label="$(tr -d '\n' <"$label_file" 2>/dev/null || true)"
		ce="$(tr -d '\n' <"$dir/dimm_ce_count" 2>/dev/null || echo 0)"
		ue="$(tr -d '\n' <"$dir/dimm_ue_count" 2>/dev/null || echo 0)"
		[[ "$ce" =~ ^[0-9]+$ ]] || ce=0
		[[ "$ue" =~ ^[0-9]+$ ]] || ue=0
		edac_ce=$((edac_ce + ce))
		edac_ue=$((edac_ue + ue))
		printf '%s ce=%s ue=%s path=%s\n' "${label:-unlabeled}" "$ce" "$ue" "$dir" >>"$workdir/edac-dimms.txt"
		if ((ue > 0)); then
			edac_ue_where+="${label:-$dir} (ue=$ue) "
		fi
	done < <(find /sys/devices/system/edac/mc -name dimm_label 2>/dev/null | sort)
}

#** collect_host: identity, boot time, and memory totals
#*
collect_host() {
	local incident_epoch boot_epoch memtotal
	{
		echo "hostname: $(hostname)"
		echo "kernel: $(uname -r)"
		echo "os: $(uname -srm)"
		echo "time: $(date '+%Y-%m-%d %H:%M:%S %Z')"
		echo "uptime: $(uptime)"
		boot_since="$(uptime -s 2>/dev/null || true)"
		echo "boot_since: ${boot_since:-unknown}"
		echo "who_b: $(who -b 2>/dev/null || true)"
		memtotal="$(awk '/^MemTotal:/{print $2, $3}' /proc/meminfo)"
		echo "mem_total: ${memtotal:-unknown}"
		hc_line="$(awk '/^HardwareCorrupted:/{print $2}' /proc/meminfo)"
		if [[ -n "$hc_line" ]]; then
			hc_kb="$hc_line"
		fi
		echo "hardware_corrupted_kb: ${hc_kb}"
		echo "incident: $opt_incident"
	} >"$workdir/host.txt"

	incident_epoch="$(date -d "$opt_incident" +%s 2>/dev/null || true)"
	boot_epoch="$(date -d "$boot_since" +%s 2>/dev/null || true)"
	if [[ -n "$incident_epoch" && -n "$boot_epoch" ]]; then
		if ((boot_epoch > incident_epoch)); then
			boot_after_incident=1
		else
			boot_after_incident=0
		fi
	fi
}

#** scan_hwpoison: list PFNs whose stable page flag bit 19 is set
#*
scan_hwpoison() {
	local page_size
	page_size="$(getconf PAGE_SIZE)"
	note "Scanning /proc/kpageflags for KPF_HWPOISON (bit $KPF_HWPOISON_BIT)"
	python3 - "$page_size" "$KPF_HWPOISON_BIT" >"$workdir/poison.txt" <<'PY'
import os, struct, sys
page_size = int(sys.argv[1])
bit = 1 << int(sys.argv[2])
path = os.environ.get("HW_FAULT_KPAGEFLAGS", "/proc/kpageflags")
try:
    fd = os.open(path, os.O_RDONLY)
except OSError as exc:
    print("error %s" % exc)
    sys.exit(0)
pfn = 0
found = []
truncated = 0
chunk = 1 << 20
while True:
    buf = os.read(fd, chunk * 8)
    if not buf:
        break
    n = len(buf) // 8
    if n == 0:
        break
    vals = struct.unpack_from("<%dQ" % n, buf)
    base = pfn
    for i, val in enumerate(vals):
        if val & bit:
            if len(found) < 10000:
                found.append(base + i)
            else:
                truncated += 1
    pfn += n
    print("scanned %d pfns" % pfn, file=sys.stderr)
os.close(fd)
print("count %d" % len(found))
print("truncated %d" % truncated)
print("pagesize %d" % page_size)
print("scanned_pfns %d" % pfn)
if not found:
    sys.exit(0)
start = prev = found[0]
ranges = []
for p in found[1:]:
    if p == prev + 1:
        prev = p
        continue
    ranges.append((start, prev))
    start = prev = p
ranges.append((start, prev))
for a, b in ranges:
    nbytes = (b - a + 1) * page_size
    print("range %#x %#x %#x %d" % (a, b, a * page_size, nbytes))
PY
	poison_pfns="$(awk '/^count /{print $2}' "$workdir/poison.txt")"
	poison_truncated="$(awk '/^truncated /{print $2}' "$workdir/poison.txt")"
	[[ "$poison_pfns" =~ ^[0-9]+$ ]] || poison_pfns=0
	[[ "$poison_truncated" =~ ^[0-9]+$ ]] || poison_truncated=0
}

#** collect_poison: HardwareCorrupted, then a page-flag scan when needed
#*
collect_poison() {
	if ((hc_kb > 0 || opt_scan_pfns == 1 || hc_kb < 0)); then
		if [[ ! -r /proc/kpageflags ]]; then
			echo "unreadable /proc/kpageflags" >"$workdir/poison.txt"
			return
		fi
		if ! command -v python3 >/dev/null 2>&1; then
			echo "python3 is required to scan /proc/kpageflags" >"$workdir/poison.txt"
			return
		fi
		scan_hwpoison
	else
		{
			echo "scan skipped"
			echo "HardwareCorrupted is 0 kB, so no page has PG_hwpoison."
			echo "Pass --scan-pfns to walk /proc/kpageflags anyway."
		} >"$workdir/poison.txt"
	fi
}

#** collect_kernel: dmesg and the persistent journal around MCA signatures
#*
collect_kernel() {
	local -i rc=0
	local pattern='MCE: Killing|hardware memory corruption|Machine [Cc]heck|Hardware Error|Memory failure|hwpoison|ADDR |SYND |IPID |mce:|EDAC|ghes|BERT|GHES'

	note "Reading kernel log since $opt_since"
	run_to "$workdir/dmesg.txt" 30 dmesg -T
	if [[ "$(cat "$workdir/dmesg.txt.rc")" -ne 0 ]]; then
		run_to "$workdir/dmesg.txt" 30 dmesg
	fi
	grep -Ei "$pattern" "$workdir/dmesg.txt" >"$workdir/dmesg-hits.txt" || true

	if command -v journalctl >/dev/null 2>&1; then
		note "Filtering kernel journal"
		timeout 90 journalctl -k --since "$opt_since" --no-pager -o short-iso \
			| grep -Ei "$pattern" >"$workdir/journal-hits.txt"
		rc="${PIPESTATUS[0]}"
	else
		: >"$workdir/journal-hits.txt"
		echo "journalctl is not installed" >"$workdir/journal-status.txt"
		rc=127
	fi

	journal_kills="$(grep -Ec 'MCE: Killing|hardware memory corruption' "$workdir/journal-hits.txt" || true)"
	dmesg_kills="$(grep -Ec 'MCE: Killing|hardware memory corruption' "$workdir/dmesg-hits.txt" || true)"
	journal_addr="$(grep -Ec 'ADDR[[:space:]]+[0-9a-fA-F]|SYND[[:space:]]+[0-9a-fA-F]' "$workdir/journal-hits.txt" || true)"
	dmesg_addr="$(grep -Ec 'ADDR[[:space:]]+[0-9a-fA-F]|SYND[[:space:]]+[0-9a-fA-F]' "$workdir/dmesg-hits.txt" || true)"

	{
		echo "journalctl_rc: $rc"
		if [[ -f "$workdir/journal-status.txt" ]]; then
			cat "$workdir/journal-status.txt"
		fi
		echo "journal_hit_lines: $(wc -l <"$workdir/journal-hits.txt" | tr -d ' ')"
		echo "journal_kill_lines: $journal_kills"
		echo "journal_addr_or_synd_lines: $journal_addr"
		echo "dmesg_hit_lines: $(wc -l <"$workdir/dmesg-hits.txt" | tr -d ' ')"
		echo "dmesg_kill_lines: $dmesg_kills"
		echo "dmesg_addr_or_synd_lines: $dmesg_addr"
		echo
		echo "---- journal lines (kill, ADDR, SYND, Hardware Error, Memory failure) ----"
		grep -E 'MCE: Killing|hardware memory corruption|Hardware Error|Memory failure|ADDR |SYND |Machine [Cc]heck' \
			"$workdir/journal-hits.txt" | head -n 160 || true
		echo
		echo "---- dmesg lines (same filter) ----"
		grep -E 'MCE: Killing|hardware memory corruption|Hardware Error|Memory failure|ADDR |SYND |Machine [Cc]heck' \
			"$workdir/dmesg-hits.txt" | head -n 160 || true
	} >"$workdir/kernel.txt"
}

#** collect_cpu: family and model, which decide whether amd64_edac can bind
#*
collect_cpu() {
	awk '
		/^processor[[:space:]]*:/ { if (seen++) exit }
		/^vendor_id[[:space:]]*:/ ||
		/^cpu family[[:space:]]*:/ ||
		/^model[[:space:]]*:/ ||
		/^model name[[:space:]]*:/ ||
		/^stepping[[:space:]]*:/ ||
		/^microcode[[:space:]]*:/ { print }
	' /proc/cpuinfo >"$workdir/cpu.txt"
	echo >>"$workdir/cpu.txt"
	lscpu | grep -E 'Model name|Socket|Vendor ID|NUMA node\(s\)|Core\(s\) per socket|Thread\(s\) per core|^CPU\(s\):|Architecture' >>"$workdir/cpu.txt" || true
	cpu_family="$(awk -F: '/^cpu family/{gsub(/ /,"",$2); print $2; exit}' "$workdir/cpu.txt")"
	cpu_model="$(awk -F: '/^model[[:space:]]*:/{gsub(/ /,"",$2); print $2; exit}' "$workdir/cpu.txt")"
	cpu_stepping="$(awk -F: '/^stepping/{gsub(/ /,"",$2); print $2; exit}' "$workdir/cpu.txt")"
	cpu_name="$(awk -F: '/^model name/{sub(/^ */,"",$2); print $2; exit}' "$workdir/cpu.txt")"
}

#** collect_edac: DIMM counters, or the result of loading amd64_edac
#*
collect_edac() {
	local -i n=0
	local mod_rc

	note "Checking EDAC"
	n="$(edac_dimm_count)"
	{
		echo "lsmod:"
		lsmod | grep -E 'edac|amd64|ghes' || echo "(none)"
		echo
		echo "edac sysfs:"
		find /sys/devices/system/edac -maxdepth 2 -type d 2>/dev/null || echo "(no /sys/devices/system/edac)"
		echo
		echo "ACPI RAS tables:"
		if [[ -d /sys/firmware/acpi/tables ]]; then
			ls /sys/firmware/acpi/tables | grep -Ei 'BERT|HEST|ERST|EINJ' || echo "(no BERT/HEST/ERST/EINJ)"
		else
			echo "(no ACPI tables sysfs)"
		fi
	} >"$workdir/edac.txt"

	if ((n > 0)); then
		edac_preexisting=1
		read_edac_counts
	elif ((opt_load_edac)); then
		if modinfo amd64_edac >/dev/null 2>&1; then
			note "No EDAC DIMMs registered. Loading amd64_edac."
			run_to "$workdir/modprobe-edac.txt" 30 modprobe amd64_edac
			mod_rc="$(cat "$workdir/modprobe-edac.txt.rc")"
			edac_load="modprobe amd64_edac rc=$mod_rc"
			{
				echo
				echo "$edac_load"
				cat "$workdir/modprobe-edac.txt"
				echo
				echo "dmesg edac lines:"
				dmesg -T 2>/dev/null | grep -Ei 'edac|amd64_edac' | tail -n 30 || true
			} >>"$workdir/edac.txt"
			n="$(edac_dimm_count)"
			if ((n > 0)); then
				read_edac_counts
			fi
		else
			edac_load="amd64_edac.ko is not installed for $(uname -r)"
			echo >>"$workdir/edac.txt"
			echo "$edac_load" >>"$workdir/edac.txt"
		fi
	else
		edac_load="modprobe skipped (--no-load-edac)"
		echo >>"$workdir/edac.txt"
		echo "$edac_load" >>"$workdir/edac.txt"
	fi

	if [[ -s "$workdir/edac-dimms.txt" ]]; then
		echo >>"$workdir/edac.txt"
		echo "dimm counters:" >>"$workdir/edac.txt"
		cat "$workdir/edac-dimms.txt" >>"$workdir/edac.txt"
	fi
}

#** ras_tables: print sqlite table names, or a short error
#*
# Arguments
#   $1 - database path
#*
ras_tables() {
	local db="$1"
	python3 - "$db" <<'PY'
import sqlite3, sys
path = sys.argv[1]
try:
    con = sqlite3.connect(path)
    rows = con.execute("select name from sqlite_master where type='table' order by 1").fetchall()
except Exception as exc:
    print("error %s" % exc)
    sys.exit(0)
if not rows:
    print("(no tables)")
else:
    for (name,) in rows:
        print(name)
PY
}

#** collect_ras: rasdaemon unit, --record, and the mc_event table
#*
collect_ras() {
	local db="/var/lib/rasdaemon/ras-mc_event.db"
	local execstart tables

	note "Checking rasdaemon"
	{
		if ! command -v systemctl >/dev/null 2>&1 || ! systemctl cat rasdaemon >/dev/null 2>&1; then
			echo "rasdaemon unit is not installed"
			ras_installed=0
		else
			ras_installed=1
			systemctl cat rasdaemon
			echo
			echo "active: $(systemctl is-active rasdaemon 2>/dev/null || true)"
			systemctl is-active --quiet rasdaemon && ras_active=1 || ras_active=0
		fi
	} >"$workdir/ras.txt"

	if ((ras_installed)); then
		execstart="$(systemctl cat rasdaemon | awk -F= '/^ExecStart=/{print substr($0, index($0, "=")+1)}')"
		echo >>"$workdir/ras.txt"
		echo "ExecStart: $execstart" >>"$workdir/ras.txt"
		if [[ " $execstart " == *" -r "* || " $execstart " == *" --record "* ]]; then
			ras_records_flag=1
		fi
		echo "record_flag: $ras_records_flag" >>"$workdir/ras.txt"
	fi

	if [[ -f "$db" ]]; then
		echo >>"$workdir/ras.txt"
		echo "database: $db" >>"$workdir/ras.txt"
		ls -l "$db" >>"$workdir/ras.txt"
		if command -v python3 >/dev/null 2>&1; then
			tables="$(ras_tables "$db")"
			echo "tables:" >>"$workdir/ras.txt"
			echo "$tables" >>"$workdir/ras.txt"
			if [[ "$tables" == *"mc_event"* ]]; then
				ras_has_mc_event=1
			else
				ras_has_mc_event=0
			fi
		else
			echo "python3 unavailable, table list skipped" >>"$workdir/ras.txt"
		fi
	else
		echo >>"$workdir/ras.txt"
		echo "database: absent ($db)" >>"$workdir/ras.txt"
		ras_has_mc_event=0
	fi

	if ((opt_repair_ras && ras_installed && ras_records_flag && ras_has_mc_event == 0)); then
		note "Recreating rasdaemon database"
		{
			echo
			echo "---- repair ----"
			systemctl stop rasdaemon
			if [[ -f "$db" ]]; then
				mv "$db" "${db}.bak.$(date +%Y%m%d%H%M%S)"
				echo "moved previous database aside"
			fi
			systemctl start rasdaemon
			sleep 2
			echo "active: $(systemctl is-active rasdaemon 2>/dev/null || true)"
			if [[ -f "$db" ]]; then
				ras_tables "$db"
			else
				echo "database was not created"
			fi
		} >>"$workdir/ras.txt"
		if [[ -f "$db" ]] && ras_tables "$db" | grep -qx mc_event; then
			ras_has_mc_event=1
		fi
	elif ((opt_repair_ras)); then
		{
			echo
			echo "repair skipped: need an installed unit whose ExecStart includes -r/--record and a missing mc_event table"
		} >>"$workdir/ras.txt"
	fi
}

#** summarize_sel_list: counts from ipmitool sel list output
#*
# Arguments
#   $1 - list output file
#*
summarize_sel_list() {
	local file="$1"
	awk -F'|' '
		NF < 5 { next }
		{
			id=$1; date=$2; time=$3; sensor=$4; desc=$5
			gsub(/^[ \t]+|[ \t]+$/, "", id)
			gsub(/^[ \t]+|[ \t]+$/, "", date)
			gsub(/^[ \t]+|[ \t]+$/, "", time)
			gsub(/^[ \t]+|[ \t]+$/, "", sensor)
			gsub(/^[ \t]+|[ \t]+$/, "", desc)
			if (id !~ /^[0-9a-fA-F]+$/) next
			n++
			ids[id]++
			stamps[date " " time]++
			descs[sensor " | " desc]++
			last=id
		}
		END {
			ic=0; for (k in ids) ic++
			tc=0; for (k in stamps) tc++
			print "parsed " n+0
			print "unique_ids " ic
			print "unique_stamps " tc
			print "last_id " last
			for (k in descs) print "desc " descs[k] "\t" k
			if (tc <= 8) for (k in stamps) print "stamp " stamps[k] "\t" k
			if (ic <= 8) for (k in ids) print "id " ids[k] "\t" k
		}
	' "$file"
}

#** find_sel_file: default to the newest /tmp/sel-*.bin
#*
find_sel_file() {
	local f newest
	if [[ -n "$opt_sel_file" ]]; then
		return
	fi
	newest=""
	for f in /tmp/sel-*.bin; do
		[[ -e "$f" ]] || continue
		if [[ -z "$newest" || "$f" -nt "$newest" ]]; then
			newest="$f"
		fi
	done
	opt_sel_file="$newest"
}

#** inspect_sel_file: unique payloads from a sel save text or writeraw file
#*
inspect_sel_file() {
	local f="$opt_sel_file"
	if [[ -z "$f" ]]; then
		echo "no sel save file found" >"$workdir/sel-file.txt"
		sel_file_note="no sel save file"
		return
	fi
	if [[ ! -f "$f" ]]; then
		echo "missing $f" >"$workdir/sel-file.txt"
		sel_file_note="missing $f"
		return
	fi
	note "Reading SEL file $f"
	python3 - "$f" >"$workdir/sel-file.txt" <<'PY'
import collections, sys
path = sys.argv[1]
data = open(path, "rb").read()
if not data:
    print("empty")
    sys.exit(0)
textish = b"\0" not in data[:4096] and (data[:4] == b"0x" or b" # " in data[:200])
if textish:
    lines = [ln.strip() for ln in data.decode("utf-8", "replace").splitlines() if ln.strip()]
    counts = collections.Counter(lines)
    print("format text")
    print("records %d" % len(lines))
    print("unique %d" % len(counts))
    for line, n in counts.most_common(12):
        print("payload %d\t%s" % (n, line))
    sys.exit(0)
if len(data) % 16 != 0:
    print("format unknown")
    print("bytes %d" % len(data))
    sys.exit(0)
import struct
counts = collections.Counter()
n = len(data) // 16
for i in range(n):
    rec = data[i*16:(i+1)*16]
    rid, rtype, ts, gen, evm, st, sn, et, e0, e1, e2 = struct.unpack_from("<HBIHBBBBBBB", rec)
    counts[(rtype, st, sn, et, e0, e1, e2, gen)] += 1
print("format binary")
print("records %d" % n)
print("unique %d" % len(counts))
for key, c in counts.most_common(12):
    rtype, st, sn, et, e0, e1, e2, gen = key
    print("payload %d\ttype=%02x sensor=%02x/%02x ev=%02x data=%02x%02x%02x gen=%04x" % (
        c, rtype, st, sn, et, e0, e1, e2, gen))
PY
	sel_file_records="$(awk '/^records /{print $2; exit}' "$workdir/sel-file.txt")"
	sel_file_unique="$(awk '/^unique /{print $2; exit}' "$workdir/sel-file.txt")"
	[[ "$sel_file_records" =~ ^[0-9]+$ ]] || sel_file_records=0
	[[ "$sel_file_unique" =~ ^[0-9]+$ ]] || sel_file_unique=0
	sel_file_note="$f"
}

#** sel_info_entries: print the Entries count, or -1
#*
# Arguments
#   $1 - sel info output
#*
sel_info_entries() {
	awk -F: '/^Entries[[:space:]]*:/{gsub(/ /,"",$2); print $2; found=1} END{if (!found) print -1}' "$1"
}

#** collect_sel: info, a short walk, one direct get, and the save file
#*
collect_sel() {
	local summary get_rc
	find_sel_file
	if ! command -v ipmitool >/dev/null 2>&1; then
		ipmi_present=0
		inspect_sel_file
		{
			echo "ipmitool is not installed"
			echo
			echo "==== sel file ($sel_file_note) ===="
			cat "$workdir/sel-file.txt"
		} >"$workdir/sel.txt"
		return
	fi
	ipmi_present=1
	note "Reading SEL info and the oldest $opt_list_count records"
	run_to "$workdir/sel-info-before.txt" 20 ipmitool sel info
	sel_before="$(sel_info_entries "$workdir/sel-info-before.txt")"
	sel_overflow="$(awk -F: '/^Overflow[[:space:]]*:/{gsub(/^[ \t]+/,"",$2); print $2; exit}' "$workdir/sel-info-before.txt")"

	run_to "$workdir/sel-list.txt" 90 ipmitool sel list "$opt_list_count"
	run_to "$workdir/sel-verbose.txt" 60 ipmitool -v sel list "$opt_verbose_count"
	summary="$(summarize_sel_list "$workdir/sel-list.txt")"
	printf '%s\n' "$summary" >"$workdir/sel-summary.txt"
	sel_parsed="$(awk '/^parsed /{print $2; exit}' "$workdir/sel-summary.txt")"
	sel_unique_ids="$(awk '/^unique_ids /{print $2; exit}' "$workdir/sel-summary.txt")"
	sel_unique_stamps="$(awk '/^unique_stamps /{print $2; exit}' "$workdir/sel-summary.txt")"
	sel_last_id="$(awk '/^last_id /{print $2; exit}' "$workdir/sel-summary.txt")"
	[[ "$sel_parsed" =~ ^[0-9]+$ ]] || sel_parsed=0
	[[ "$sel_unique_ids" =~ ^[0-9]+$ ]] || sel_unique_ids=0
	[[ "$sel_unique_stamps" =~ ^[0-9]+$ ]] || sel_unique_stamps=0

	if [[ -n "$sel_last_id" ]]; then
		note "Fetching SEL record $sel_last_id directly"
		run_to "$workdir/sel-get.txt" 20 ipmitool sel get "0x$sel_last_id"
		get_rc="$(cat "$workdir/sel-get.txt.rc")"
		if ((get_rc == 0)) && ! grep -qi 'not found' "$workdir/sel-get.txt"; then
			sel_get_ok=1
		else
			sel_get_ok=0
		fi
	fi

	run_to "$workdir/sel-info-after.txt" 20 ipmitool sel info
	sel_after="$(sel_info_entries "$workdir/sel-info-after.txt")"

	run_to "$workdir/sel-time.txt" 20 ipmitool sel time get
	date '+%Y-%m-%d %H:%M:%S %Z' >"$workdir/host-time.txt"
	sel_clock_delta="$(python3 - "$workdir/sel-time.txt" <<'PY'
import sys
from datetime import datetime
raw = open(sys.argv[1], encoding="utf-8", errors="replace").read().strip().splitlines()
line = raw[-1].strip() if raw else ""
for fmt in ("%m/%d/%Y %H:%M:%S", "%m/%d/%Y %H:%M:%S %Z"):
    try:
        sel = datetime.strptime(line, fmt)
        break
    except ValueError:
        sel = None
if sel is None:
    print(-1)
else:
    delta = abs(int(datetime.now().timestamp() - sel.timestamp()))
    print(delta)
PY
)"
	[[ "$sel_clock_delta" =~ ^[0-9]+$ ]] || sel_clock_delta=-1

	inspect_sel_file

	sel_payload="$(awk -F: '/Event Data/{gsub(/^[ \t]+/,"",$2); print $2}' "$workdir/sel-verbose.txt" | sort | uniq -c | tr -s ' ')"
	sel_desc_summary="$(grep '^desc ' "$workdir/sel-summary.txt" || true)"

	{
		echo "==== sel info before ===="
		cat "$workdir/sel-info-before.txt"
		echo
		echo "==== sample summary ===="
		cat "$workdir/sel-summary.txt"
		echo
		echo "==== sel get ${sel_last_id:-n/a} ===="
		if [[ -f "$workdir/sel-get.txt" ]]; then
			cat "$workdir/sel-get.txt"
		else
			echo "(not attempted)"
		fi
		echo
		echo "==== sel info after ===="
		cat "$workdir/sel-info-after.txt"
		echo
		echo "==== sel time ===="
		cat "$workdir/sel-time.txt"
		echo "host time: $(cat "$workdir/host-time.txt")"
		echo "abs_delta_seconds: $sel_clock_delta"
		echo
		echo "==== verbose sample ===="
		cat "$workdir/sel-verbose.txt"
		echo
		echo "==== sel file ($sel_file_note) ===="
		cat "$workdir/sel-file.txt"
	} >"$workdir/sel.txt"
}

