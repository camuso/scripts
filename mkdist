#!/bin/bash
#
# mkdist - Build a kernel RPM set, using a toolbox when available.
#
# Must be run from the root of a RHEL/CentOS kernel tree.
# Auto-detects the RHEL version from redhat/Makefile.variables and
# selects the matching toolbox container for the build.
#
# Toolbox container naming convention:
#   .el9  -> rhel9       (or c9s)
#   .el10 -> c10s        (or rhel10)
#   .fc*/rawhide -> rawhide
#
# Override with: TOOLBOX=<name> mkdist
#

[ -n "$MYDIR" ] || {
	declare MYDIR=
	MYDIR="$(dirname "$(readlink -f "$0")")"
}

declare usagestr="$(
cat <<EOF

$(basename "$0") [OPTIONS]

Build a RHEL kernel RPM set.  By default builds the base (non-debug)
kernel only, skipping perf/tools/RT.  Must be run from the root of a
kernel tree.

OPTIONS
    -d        Build the debug kernel instead of the base kernel
              (enables PROVE_LOCKING/lockdep, KASAN, DEBUG_OBJECTS, etc.)
    -t NAME   Toolbox container name (overrides auto-detect)
    -n        No toolbox -- run the build directly on the host
    -h        Show this help

ENVIRONMENT
    TOOLBOX             Same as -t (command-line flag takes precedence)
    HEARTBEAT_INTERVAL  Seconds between "still working" messages during
                        quiet build phases (default: 30)

EOF
)"

usage() {
	echo -e "$usagestr"
}

control_c() {
	[[ -t 0 ]] && printf "\n" > /dev/tty 2>/dev/null
	echo -e "\nCtrl-c detected\nCleaning up and exiting."
	[[ -n "${build_pid:-}" ]] && kill "$build_pid" 2>/dev/null
	[[ -n "${stage_file:-}" ]] && rm -f "$stage_file"
	exit $CTLC_EXIT
}

# Heartbeat interval (seconds) between "still working" reassurance messages.
declare -i HEARTBEAT_INTERVAL="${HEARTBEAT_INTERVAL:-30}"

# Map a line of build output to a short, human-readable description of
# what's happening right now.  Echoes the description on a match;
# returns non-zero (and echoes nothing) otherwise, in which case the
# caller keeps showing whatever stage it last detected.
detect_stage() {
	case "$1" in
		*'/configs/kernel-'*)          echo "processing kernel configs" ;;
		*'Processing uki_addons'*)     echo "processing UKI addons" ;;
		*'Creating linux-'*'.tar.'*)   echo "building the source tarball" ;;
		*'Copying sources for'*)       echo "copying kernel sources" ;;
		*'Executing(%prep)'*)          echo "unpacking the kernel source" ;;
		*'Executing(%build)'*)         echo "starting the kernel build" ;;
		*'BUILDING A KERNEL FOR'*)     echo "compiling the kernel" ;;
		*'modules_install'*)           echo "installing kernel modules" ;;
		*' modules'*)                  echo "building kernel modules" ;;
		*'Executing(%install)'*)       echo "installing build results" ;;
		*'Executing(%files)'*)         echo "packaging the RPMs" ;;
		*'Wrote: '*)                   echo "finishing up" ;;
		*)                             return 1 ;;
	esac
}

# Run "$@" in the background and show a spinner (on a tty) or a plain
# periodic heartbeat (otherwise) until it finishes, describing the
# current build stage.  Some build steps (e.g. compressing the source
# tarball, compiling) produce no output for a long time and can look
# like a hang, so this keeps the user reassured.
# Sets globals: build_pid, stage_file.  Returns the exit code of "$@".
run_with_heartbeat() {
	stage_file=$(mktemp)

	# Relay the command's output unchanged (to whatever fd 1 already
	# points at -- main() has it teeing to the log) while also peeking
	# at each line to update the current-stage file.
	relay_and_watch() {
		local line stage
		while IFS= read -r line; do
			printf '%s\n' "$line"
			stage=$(detect_stage "$line") && printf '%s' "$stage" > "$stage_file"
		done
	}

	"$@" > >(relay_and_watch) 2>&1 &
	build_pid=$!

	local start now elapsed mins secs next_msg cur_stage last_stage=""
	start=$(date +%s)
	next_msg=$((start + HEARTBEAT_INTERVAL))

	# Note: main() redirects stdout/stderr through `tee` via process
	# substitution, so fd 1/2 are pipes even in an interactive shell.
	# Check stdin instead (untouched by that redirection) to decide
	# whether a spinner makes sense.
	if [[ -t 0 ]]; then
		local spinchars='|/-\' i=0
		tput civis > /dev/tty 2>/dev/null
		while kill -0 "$build_pid" 2>/dev/null; do
			i=$(( (i + 1) % 4 ))
			now=$(date +%s)
			elapsed=$((now - start))
			mins=$((elapsed / 60))
			secs=$((elapsed % 60))
			cur_stage=$(cat "$stage_file" 2>/dev/null)
			[[ -z "$cur_stage" ]] && cur_stage="preparing the build"
			if [[ "$cur_stage" != "$last_stage" ]]; then
				[[ -n "$last_stage" ]] && printf "\n" > /dev/tty
				last_stage="$cur_stage"
			fi
			printf "\r\033[K  %s I'm still %s ... (%dm %02ds elapsed)" \
				"${spinchars:$i:1}" "$cur_stage" "$mins" "$secs" > /dev/tty
			sleep 0.2
		done
		printf "\r\033[K" > /dev/tty
		tput cnorm > /dev/tty 2>/dev/null
	else
		while kill -0 "$build_pid" 2>/dev/null; do
			sleep 1
			now=$(date +%s)
			elapsed=$((now - start))
			mins=$((elapsed / 60))
			secs=$((elapsed % 60))
			cur_stage=$(cat "$stage_file" 2>/dev/null)
			[[ -z "$cur_stage" ]] && cur_stage="preparing the build"
			if [[ "$cur_stage" != "$last_stage" ]]; then
				echo "Now ${cur_stage} ... (${mins}m ${secs}s elapsed)"
				last_stage="$cur_stage"
				next_msg=$((now + HEARTBEAT_INTERVAL))
			elif (( now >= next_msg )); then
				echo "Still ${cur_stage} ... (${mins}m ${secs}s elapsed)"
				next_msg=$((now + HEARTBEAT_INTERVAL))
			fi
		done
	fi

	wait "$build_pid"
	local -i rc=$?
	rm -f "$stage_file"
	return $rc
}

exitme() {
	local -i code="$1"
	local msg="$2"

	((code == 0)) && exit "$code"
	echo -e "$msg"
	usage
	exit "$code"
}

# Detect the RHEL version from the kernel tree and pick a toolbox.
# Sets global: toolbox_name
detect_toolbox() {
	local dist
	local el_ver

	if [[ ! -f redhat/Makefile.variables ]]; then
		echo "Warning: redhat/Makefile.variables not found."
		echo "         Are you in a RHEL kernel tree?"
		toolbox_name=""
		return 1
	fi

	dist=$(grep -oP '(?<=DIST \?= )\.el\d+' redhat/Makefile.variables 2>/dev/null)
	el_ver=${dist#.el}

	if [[ -z "$el_ver" ]]; then
		# Fedora/Rawhide trees use .fc<N> instead of .el<N>
		if grep -qP '(?<=DIST \?= )\.fc\d+' redhat/Makefile.variables 2>/dev/null; then
			if toolbox list -c 2>/dev/null | grep -qw rawhide; then
				toolbox_name="rawhide"
				return 0
			fi
			echo "Warning: no 'rawhide' toolbox container found."
			toolbox_name=""
			return 1
		fi
		echo "Warning: could not determine RHEL version from DIST."
		toolbox_name=""
		return 1
	fi

	# Try container names in preference order
	local -a candidates
	case "$el_ver" in
		9)  candidates=(c9s rhel9) ;;
		10) candidates=(c10s rhel10) ;;
		*)  candidates=("c${el_ver}s" "rhel${el_ver}") ;;
	esac

	local name
	for name in "${candidates[@]}"; do
		if toolbox list -c 2>/dev/null | grep -qw "$name"; then
			toolbox_name="$name"
			return 0
		fi
	done

	echo "Warning: no toolbox container found for RHEL-${el_ver}."
	echo "         Looked for: ${candidates[*]}"
	toolbox_name=""
	return 1
}

main() {
	local mkstart mkend mkdiff etmins etsecs
	local use_toolbox=true
	local build_debug=false
	local toolbox_name="${TOOLBOX:-}"
	local logfile="../mkdist.log"

	exec > >(tee "$logfile") 2>&1

	while getopts "dt:nh" opt; do
		case "$opt" in
			d) build_debug=true ;;
			t) toolbox_name="$OPTARG" ;;
			n) use_toolbox=false ;;
			h) usage; exit 0 ;;
			*) exitme 1 "" ;;
		esac
	done

	if [[ ! -f Makefile ]] || ! grep -q 'dist-rpm-baseonly' redhat/Makefile 2>/dev/null; then
		exitme 1 "Error: not in a RHEL kernel tree root."
	fi

	if $use_toolbox && [[ -z "$toolbox_name" ]]; then
		detect_toolbox || use_toolbox=false
	fi

	# Validate the toolbox exists if specified
	if $use_toolbox && [[ -n "$toolbox_name" ]]; then
		if ! toolbox list -c 2>/dev/null | grep -qw "$toolbox_name"; then
			exitme 1 "Error: toolbox container '$toolbox_name' not found."
		fi
	fi

	trap control_c SIGINT

	local flavor_opts
	if $build_debug; then
		# --with dbgonly: skip base kernel, build only debug variant
		flavor_opts="--with dbgonly --without debuginfo"
		echo "Build flavor: DEBUG (lockdep, KASAN, DEBUG_OBJECTS)"
	else
		# Build only the base kernel (skip debug)
		flavor_opts="--without debug --without debuginfo"
		echo "Build flavor: base"
	fi

	local build_cmd
	build_cmd="make dist-rpm-baseonly \
RPMBUILDOPTS=\"--target \$(uname -m) \
${flavor_opts} \
--without vdso_install \
--without bpftool \
--without perf \
--without libperf \
--without tools \
--without selftests \
--without realtime \
--without doc \
--without cross_headers \
-bb\""

	# Validate any existing source tarball before building
	local tarball
	for tarball in redhat/rpm/SOURCES/linux-*.tar.xz; do
		if [[ -f "$tarball" ]]; then
			if ! xz -t "$tarball" 2>/dev/null; then
				echo "WARNING: Corrupt tarball detected: $tarball"
				echo "  Removing to force regeneration ..."
				rm -f "$tarball"
				# Also remove the hardlink in redhat/ if present
				local base_tarball="redhat/$(basename "$tarball")"
				[[ -f "$base_tarball" ]] && rm -f "$base_tarball"
			fi
		fi
	done

	mkstart=$(date +%s)

	local -i rc
	if $use_toolbox; then
		local here
		here="$(pwd)"
		echo "Building in toolbox: $toolbox_name"
		echo "Kernel tree: $here"
		echo ""
		cd "$HOME"
		run_with_heartbeat toolbox run -c "$toolbox_name" \
			bash -c "cd /run/host${here} && ${build_cmd}"
		rc=$?
	else
		echo "Building on host (no toolbox)"
		echo ""
		run_with_heartbeat bash -c "$build_cmd"
		rc=$?
	fi
	mkend=$(date +%s)
	mkdiff=$((mkend - mkstart))
	etmins=$((mkdiff / 60))
	etsecs=$((mkdiff % 60))

	echo ""
	echo "Elapsed time: ${etmins}m ${etsecs}s"

	if ((rc == 0)); then
		local rpmdir="redhat/rpm/RPMS/$(uname -m)"
		if [[ -d "$rpmdir" ]]; then
			echo ""
			echo "RPMs:"
			ls -1 "$rpmdir"/*.rpm 2>/dev/null
		fi
	else
		echo "Build FAILED (exit code $rc)"
	fi

	exit $rc
}

main "$@"
