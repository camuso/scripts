#!/bin/bash
#
# githubsync
#

set +x

[ -n "$MYDIR" ] || {
	declare MYDIR=
	MYDIR="$(dirname "$(readlink -f "$0")")"
}

load_bwsecrets() {
	local lib="${BWSECRETS_LIB:-}"

	if [[ -z "$lib" ]]; then
		lib="$(dirname "$(readlink -f "$0")")/lib/bwsecrets.sh"
		[[ -f "$lib" ]] || lib="$HOME/bin/lib/bwsecrets.sh"
	fi
	# shellcheck disable=SC1090
	source "$lib"
}

declare usagestr="$(
cat <<EOF

$(basename "$0")
\0
EOF
)"

#** usage: print info and instructions to screen
#
# Global
# 	usagestr
#*
usage() {
	echo -e "$usagestr"
}

#** control_c: control-c trap
#
# Global
#   CTLC_EXIT - bash environment variable
#*
control_c() {
	echo -e "\nCtrl-c detected\nCleaning up and exiting."
	exit $CTLC_EXIT
}

#** exitme
#
# Arguments
#   $1 - exit code
#   $2 - optional message
#*
exitme() {
	local -i code="$1"
	local msg="$2"

	((code == 0)) && exit "$code"
	echo -e "$msg"
	usage
	exit "$code"
}

#** main
#*
main() {
        # Trap for control-c
        trap control_c SIGINT

	## The following is courtesy of CoPilot
	##
	##
	# --- CONFIG ---
	API="https://api.github.com/user/keys"
	TITLE="$(hostname)-$(date +%Y%m%d)"
	KEYFILE=""

	load_bwsecrets
	trap 'unset github_token; bw_lock' EXIT
	bw_require || exit 1
	load_vault_tokens || exit 1

	# --- KEY DETECTION ---
	if [[ -f ~/.ssh/id_ed25519.pub ]]; then
	  KEYFILE=~/.ssh/id_ed25519.pub
	elif [[ -f ~/.ssh/id_rsa.pub ]]; then
	  KEYFILE=~/.ssh/id_rsa.pub
	else
	  echo "No SSH public key found." >&2
	  exit 1
	fi

	PUBKEY=$(<"$KEYFILE")
	LOCAL_FP=$(ssh-keygen -lf "$KEYFILE" | awk '{print $2}')

	# --- FETCH EXISTING KEYS ---
	EXISTING="$(curl_with_token Authorization "Bearer $github_token" \
		-sS -H "Accept: application/vnd.github+json" "$API")"

	# --- FINGERPRINT MATCH ---
	if echo "$EXISTING" | jq -r '.[].key' \
	   | ssh-keygen -lf /dev/stdin 2>/dev/null \
	   | awk '{print $2}' | grep -q "$LOCAL_FP"; then
	  echo "Key already exists on GitHub (fingerprint $LOCAL_FP)."
	else
	  echo "Uploading SSH key to GitHub..."
	  resp="$(secret_tmp)" || exit 1
	  RESP="$(curl_with_token Authorization "Bearer $github_token" \
	    -sS -o "$resp" -w "%{http_code}" \
	    -H "Accept: application/vnd.github+json" \
	    -d "{\"title\":\"${TITLE}\",\"key\":\"${PUBKEY}\"}" \
	    "$API")" || RESP="000"

	  if [[ "$RESP" == "201" || "$RESP" == "422" ]]; then
	    echo "Key is present on GitHub (HTTP $RESP)."
	  else
	    echo "Upload failed (HTTP $RESP)." >&2
	    secret_shred "$resp"
	    exit 1
	  fi
	  secret_shred "$resp"
	fi

	# --- CONFIGURE GIT ---
	git config --global url."git@github.com:".insteadOf "https://github.com/"
	echo "Git configured to use SSH for GitHub repos."

	# --- TEST CONNECTION ---
	echo "Testing SSH connection to GitHub..."
	ssh -o StrictHostKeyChecking=accept-new -T git@github.com || true

	# --- CLEANUP ---
	unset github_token
	bw_lock

	exitme 0
}

main "$@"
