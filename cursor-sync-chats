#!/bin/bash
#
# cursor-sync-chats - sync Cursor chat transcripts between machines
#
# Syncs the agent-transcripts directories under ~/.cursor/projects/.
# Uses rsync --ignore-existing so chats on the destination are never
# overwritten — only new UUID directories are added.
#
# Safe to run while Cursor is open on either end (plain JSONL files,
# not SQLite databases).
#
# Usage: cursor-sync-chats [--push|--pull] [remote-host]
#        cursor-sync-chats  (push to default host)
#
# Typical CSB laptop workflow (laptop cannot be reached from lab):
#   cursor-sync-chats --pull hp-dl380pgen9-07.khw.eng.rdu2.dc.redhat.com
#
# Tony Camuso / Claude opus4.6

declare default_host="dell-per640-01.khw.eng.rdu2.dc.redhat.com"
declare direction="push"
declare remote=""
declare local_projects="$HOME/.cursor/projects"
declare remote_projects=""
declare -i errs=0

# Disable LocalForward/RemoteForward from ~/.ssh/config (e.g. VNC 5902).
# Sync only needs a plain shell/rsync channel; bound forwards cause
# "bind [127.0.0.1]:5902: Address already in use" on the laptop.
declare -a ssh_opts=(
	-o ConnectTimeout=5
	-o BatchMode=yes
	-o ClearAllForwardings=yes
)
declare rsync_ssh="ssh ${ssh_opts[*]}"

# Projects that have agent-transcripts worth syncing
declare -a workspaces=(
	home-tcamuso-bin
	home-tcamuso-patchtools
	home-tcamuso-isb
)

usage() {
	echo "Usage: ${0##*/} [--push|--pull] [remote-host]"
	echo ""
	echo "  --push   Push local transcripts to remote (default)"
	echo "  --pull   Pull remote transcripts to local"
	echo "  -h       Show this help"
	echo ""
	echo "  Default host: $default_host"
	echo "  Safe to run while Cursor is open on either end."
	echo ""
	echo "  CSB laptop example (run on the laptop):"
	echo "    ${0##*/} --pull <lab-host>"
	exit 1
}

while (( $# )); do
	case "$1" in
	--push)  direction="push"; shift ;;
	--pull)  direction="pull"; shift ;;
	-h|--help) usage ;;
	-*)
		echo "ERROR: Unknown option: $1"
		usage
		;;
	*)
		remote="$1"
		shift
		;;
	esac
done

remote="${remote:-$default_host}"

# Verify SSH connectivity
if ! ssh "${ssh_opts[@]}" "$remote" true 2>/dev/null; then
	echo "ERROR: Cannot reach $remote via SSH."
	if [[ "$direction" == "push" ]]; then
		echo "Hint: if the remote is a laptop behind NAT/firewall, run this"
		echo "      on the laptop instead with:  ${0##*/} --pull <this-host>"
	fi
	exit 1
fi

# Resolve remote HOME independently. CSB/ostree laptops often use
# /var/home/$USER while lab hosts use /home/$USER — baking the local
# $HOME into remote paths makes every workspace look empty.
remote_home=$(ssh "${ssh_opts[@]}" "$remote" 'printf %s "$HOME"')
if [[ -z "$remote_home" ]]; then
	echo "ERROR: Could not determine remote HOME on $remote."
	exit 1
fi
remote_projects="$remote_home/.cursor/projects"
echo "Remote projects: $remote_projects"

for ws in "${workspaces[@]}"; do
	local_dir="$local_projects/$ws/agent-transcripts"
	remote_dir="$remote_projects/$ws/agent-transcripts"
	remote_spec="$remote:$remote_dir/"

	if [[ "$direction" == "push" ]]; then
		src="${local_dir}/"
		dst="$remote_spec"

		if [[ ! -d "$local_dir" ]]; then
			echo "SKIP: $ws (no local transcripts)"
			continue
		fi

		# Ensure remote destination exists
		ssh "${ssh_opts[@]}" "$remote" "mkdir -p '$remote_dir'"
	else
		src="$remote_spec"
		dst="${local_dir}/"

		# Ensure local destination exists
		mkdir -p "$local_dir"

		# Skip if remote has nothing for this workspace
		if ! ssh "${ssh_opts[@]}" "$remote" "test -d '$remote_dir'"; then
			echo "SKIP: $ws (no remote transcripts at $remote_dir)"
			continue
		fi
	fi

	echo -n "${direction^}ing $ws ... "
	if rsync -a --ignore-existing -e "$rsync_ssh" "$src" "$dst"; then
		echo "OK"
	else
		echo "FAILED"
		(( errs++ ))
	fi
done

if (( errs )); then
	echo "$errs workspace(s) failed."
	exit 1
else
	echo "Done."
fi
