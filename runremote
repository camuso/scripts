#!/bin/bash
#
# runremote: copy a local script to a host and run it on a terminal.
#
# Secret environment variables are not forwarded. Bitwarden prompts need
# a tty, so the remote command is started with ssh -t.

set +x

declare user="$1"
declare host="$2"
declare script="$3"

if [[ -z "$user" || -z "$host" || -z "$script" ]]; then
	echo "Usage: $(basename "$0") user host script [args...]" >&2
	exit 1
fi
if [[ ! -f "$script" ]]; then
	echo "Script not found: $script" >&2
	exit 1
fi

shift 3

declare ssh_opts="-o StrictHostKeyChecking=accept-new"
declare remote_lib=".local/lib"
declare remote_dir=".cache/runremote"
declare name
declare lib
declare here
declare remote_prefix
declare -a quoted=()
declare arg

name="$(basename "$script")"
here="$(dirname "$(readlink -f "$0")")"
lib="$here/lib/bwsecrets.sh"

ssh $ssh_opts "$user@$host" \
	"mkdir -p ~/$remote_lib ~/$remote_dir && chmod 700 ~/$remote_lib ~/$remote_dir" \
	|| exit 1

if [[ -f "$lib" ]]; then
	scp $ssh_opts "$lib" "$user@$host:$remote_lib/bwsecrets.sh" || exit 1
	ssh $ssh_opts "$user@$host" "chmod 600 ~/$remote_lib/bwsecrets.sh" || exit 1
fi

scp $ssh_opts "$script" "$user@$host:$remote_dir/$name" || exit 1
ssh $ssh_opts "$user@$host" "chmod 700 ~/$remote_dir/$name" || exit 1

for arg in "$@"; do
	quoted+=("$(printf '%q' "$arg")")
done

remote_prefix="BWSECRETS_LIB=\$HOME/$remote_lib/bwsecrets.sh"
if [[ "${BW_KEEP_SESSION:-}" == "yes" ]]; then
	remote_prefix="BW_KEEP_SESSION=yes $remote_prefix"
fi

# shellcheck disable=SC2029
exec ssh -t $ssh_opts "$user@$host" \
	"$remote_prefix bash \$HOME/$remote_dir/$name ${quoted[*]}"
